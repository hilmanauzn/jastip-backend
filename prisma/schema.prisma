generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Restaurant {
  id              String   @id @default(cuid())
  name            String   @unique
  jastipFee       Int
  multiple        Int
  taxService      Int      @default(0)
  taxCharge       Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  menus           MenuItem[]
  orderFees       OrderRestaurantFee[]
  jastipOverrides JastipOverride[]
}

model MenuItem {
  id              String   @id @default(cuid())
  externalId      String?  @unique
  restaurantId    String
  name            String
  description     String?
  price           Int
  category        String
  includeJastip   Boolean  @default(true)
  jastipFeeSpecial Int?
  addons          String   @default("[]") // JSON string
  imageUrl        String?
  isAvailable     Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  restaurant      Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orderItems      OrderItem[]

  @@index([restaurantId])
  @@index([category])
  @@index([isAvailable])
}

model Customer {
  id        String   @id @default(cuid())
  name      String   @unique
  phone     String?
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders    Order[]
}

model Order {
  id              String   @id @default(cuid())
  orderNumber     String   @unique
  customerId      String
  customerName    String
  status          String   @default("DRAFT") // DRAFT, CONFIRMED, PAID, CANCELLED
  subtotal        Int      @default(0)
  jastipFeeTotal  Int      @default(0)
  taxServiceTotal Int      @default(0)
  taxChargeTotal  Int      @default(0)
  grandTotal      Int      @default(0)
  ongkir          Int      @default(0)
  destination     String?
  paymentStatus   String   @default("Belum Dibayar")
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  customer        Customer @relation(fields: [customerId], references: [id])
  items           OrderItem[]
  restaurantFees  OrderRestaurantFee[]
}

model OrderItem {
  id              String   @id @default(cuid())
  orderId         String
  menuItemId      String?
  name            String
  description     String?
  price           Int
  basePrice       Int?
  quantity        Int      @default(1)
  category        String
  includeJastip   Boolean  @default(true)
  jastipFeeSpecial Int?
  selectedAddon   String?
  isManual        Boolean  @default(false)
  subtotal        Int
  createdAt       DateTime @default(now())

  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem        MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

model OrderRestaurantFee {
  id              String   @id @default(cuid())
  orderId         String
  restaurantId    String
  restaurantName  String
  subtotal        Int
  subtotalTaxable Int
  subtotalNonTax  Int
  calculatedFee   Int
  overrideFee     Int?
  finalFee        Int
  taxServiceAmount Int
  taxChargeAmount Int
  total           Int
  totalQuantity   Int
  qtyIncludeJastip Int
  multiple        Int
  batches         Int
  hasMultipleWarning Boolean
  createdAt       DateTime @default(now())

  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  restaurant      Restaurant @relation(fields: [restaurantId], references: [id])

  @@unique([orderId, restaurantId])
}

model JastipOverride {
  id            String   @id @default(cuid())
  restaurantId  String
  fee           Int
  createdBy     String?
  createdAt     DateTime @default(now())

  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId])
}

model Settings {
  id            String   @id @default("singleton")
  shopName      String   @default("Titipmarinceu")
  tagline       String   @default("Jasa Titip Makanan Viral Bandung")
  bankAccounts  String   @default("[]") // JSON string
  qrisImageUrl  String?
  logoUrl       String?
  updatedAt     DateTime @updatedAt
}